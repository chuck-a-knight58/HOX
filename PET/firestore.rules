rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list in sync with PET_ADMIN_EMAILS in firebase-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'chuck@xanadukink.com',
          'chuck.a.knight@gmail.com',
          'l.knight@me.com'
        ];
    }

    function isOwnerDoc() {
      return request.auth != null
        && (resource.data.authUid == request.auth.uid
            || resource.data.email == request.auth.token.email);
    }

    // On create, applicants must submit as 'pending' with no admin fields set.
    function cleanCreatePayload() {
      let adminOnly = [
        'status', 'authUid',
        'approvedAt', 'approvedBy',
        'rejectedAt', 'rejectedBy'
      ];
      let submitted = request.resource.data;
      return submitted.status == 'pending'
        && !submitted.keys().hasAny(adminOnly.removeAll(['status']));
    }

    // -------- Leadership applications (public apply → admin approve) --------
    match /applications/{doc} {
      allow create: if cleanCreatePayload();
      allow read:   if isAdmin() || isOwnerDoc();
      allow update, delete: if isAdmin();
    }

    // -------- Leader profiles (owner edits own; admin manages all) --------
    // Doc id == the leader's auth uid.
    match /leaders/{uid} {
      allow read: if request.auth != null;          // any signed-in leader can view the roster
      allow create, update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            // owners may not grant themselves admin-controlled fields
            && !request.resource.data.diff(
                 resource == null ? request.resource.data : resource.data
               ).affectedKeys().hasAny(['status']));
      allow delete: if isAdmin();
    }

    // NOTE: The chapter directory is served from the static file chapters.json
    // (not Firestore) — edit that file to update the public chapters listing.

    // -------- Library resources (leaders read; admin write) --------
    match /library_resources/{doc} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // -------- Contact messages (public create; admin read) --------
    match /contact_messages/{doc} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read:           if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
