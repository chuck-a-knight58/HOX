rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Keep this list in sync with PET_ADMIN_EMAILS in firebase-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'chuck@xanadukink.com',
          'chuck.a.knight@gmail.com',
          'l.knight@me.com'
        ];
    }

    // Library files: any signed-in leader may download; only admins may
    // upload, overwrite, or delete.
    match /library/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
