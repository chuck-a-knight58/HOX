<IfModule mod_rewrite.c>
RewriteEngine On
# Send every request to https://www.xanadukink.com (the address used by the
# canonical tags and sitemap): http -> https, and xanadukink.com -> www.
RewriteCond %{HTTP_HOST} ^(www\.)?xanadukink\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^xanadukink\.com$ [NC]
RewriteRule ^(.*)$ https://www.xanadukink.com/$1 [L,R=301]
</IfModule>

<ifModule mod_headers.c>
 Header always set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>
