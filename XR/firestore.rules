rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'chuck@xanadukink.com',
          'chuck.a.knight@gmail.com',
          'l.knight@me.com'
        ];
    }

    function isOwner() {
      return request.auth != null
        && (resource.data.authUid == request.auth.uid
            || resource.data.email == request.auth.token.email);
    }

    // On update, owners must not touch any admin-controlled field.
    function ownerProtectedFieldsUnchanged() {
      let adminOnly = [
        'status', 'authUid',
        'approvedAt', 'approvedBy',
        'rejectedAt', 'rejectedBy'
      ];
      return !request.resource.data
               .diff(resource.data)
               .affectedKeys()
               .hasAny(adminOnly);
    }

    // On create, applicants must submit as 'pending' with no admin fields set.
    function cleanCreatePayload() {
      let adminOnly = [
        'status', 'authUid',
        'approvedAt', 'approvedBy',
        'rejectedAt', 'rejectedBy'
      ];
      let submitted = request.resource.data;
      return submitted.status == 'pending'
        && !submitted.keys().hasAny(adminOnly.removeAll(['status']));
    }

    match /applications/{doc} {
      allow create: if cleanCreatePayload();
      allow read:   if isAdmin() || isOwner();
      allow update: if isAdmin()
                    || (isOwner() && ownerProtectedFieldsUnchanged());
      allow delete: if isAdmin();
    }

    // Attendee Information Form (info.html) — submitted by prospective
    // attendees who may not be logged in. Public create gated to a clean
    // 'pending' payload with no admin fields; admin-only read; no client
    // updates or deletes.
    match /attendee_info/{doc} {
      allow create: if cleanCreatePayload();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    match /newsletter_subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200;
      allow read:           if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
